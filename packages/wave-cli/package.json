{
  "name": "@purplemon/wave-cli",
  "version": "0.1.0",
  "description": "The `wave` command line: studio, serve, sql, schema push/diff, export/import",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wave": "dist/main.js"
  },
  "files": [
    "dist",
    "studio"
  ],
  "scripts": {
    "prepare": "node ../../scripts/prepare-wave-cli.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purplem0n/wavedb.git",
    "directory": "packages/wave-cli"
  },
  "dependencies": {
    "@purplemon/wavedb": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
