{
  "name": "wavedb",
  "version": "0.1.0",
  "description": "WaveDB — concurrent-write embedded relational database with a TypeScript-first API (Node + Bun)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "bun": "./src/index.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "bun": "./src/server.ts", "default": "./dist/server.js" }
  },
  "files": ["dist", "native", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test"
  },
  "engines": { "node": ">=20" }
}
