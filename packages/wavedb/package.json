{
  "name": "@purplemon/wavedb",
  "version": "0.1.3",
  "description": "WaveDB — concurrent-write embedded relational database with a TypeScript-first API (Node + Bun)",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purplem0n/wavedb.git",
    "directory": "packages/wavedb"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "studio",
    "native",
    "scripts/install-native.mjs",
    "README.md"
  ],
  "scripts": {
    "prepare": "node ../../scripts/prepare-wavedb.mjs",
    "postinstall": "node scripts/install-native.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:native": "node ../../scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test"
  },
  "napi": {
    "binaryName": "wave",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "latest",
    "hono": "^4.13.13",
    "typescript": "latest"
  }
}
