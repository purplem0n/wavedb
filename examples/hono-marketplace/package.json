{
  "name": "hono-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test:studio": "bun run scripts/test-studio-embed.ts",
    "test:studio:npm": "bun run scripts/test-studio-npm-install.ts",
    "seed": "bun run scripts/seed.ts",
    "seed:force": "bun run scripts/seed.ts --force",
    "seed:small": "bun run scripts/seed-small.ts",
    "seed:small:force": "bun run scripts/seed-small.ts --force",
    "studio": "wave studio data.wave",
    "stress": "bun run scripts/stress.ts",
    "stress:quick": "STRESS_DURATION_SEC=30 SEED_PROFILE=quick bun run scripts/stress.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "@purplemon/wavedb": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
